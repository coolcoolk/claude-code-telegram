#!/bin/sh
# pre-push: refuse to push a commit whose tree does not match the release
# generator's manifest (see .githooks/check-generated.py). Enabled per clone:
#   git config core.hooksPath .githooks
ROOT="$(git rev-parse --show-toplevel)" || exit 2
ZERO=0000000000000000000000000000000000000000
rc=0
while read -r _lref lsha _rref _rsha; do
  case "$lsha" in "$ZERO"|"") continue ;; esac
  sha="$(git rev-parse -q --verify "$lsha^{commit}")" || continue
  python3 "$ROOT/.githooks/check-generated.py" --rev "$sha" || rc=1
done
exit $rc
